# --- Core ---
PROJECT_ID=my-gcp-project-id
PROJECT_NAME=OmniHub
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Security ---
# SECRET_KEY for JWT (Generate using: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_string
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Google Cloud ---
# Path to service account json (relative to backend root). 
# [Local] Set this to '_local_secrets/service_account.json'
# [Cloud Run] Leave empty (uses ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# Region for Vertex AI & Document AI
VERTEX_LOCATION=us-central1
DOC_AI_LOCATION=us

# --- DocAI ---
# Processor IDs (Create in Google Cloud Console)
DOCAI_PROCESSOR_ID=your-general-processor-id
DOC_AI_PROCESSOR_ID_PDF=your-pdf-processor-id
DOC_AI_PROCESSOR_ID_IMAGE=your-ocr-processor-id

# --- Storage & Database ---
GCS_BUCKET=your-gcs-bucket-name
FIRESTORE_DATABASE=(default)
GCS_PREFIX=omnihub-data

# --- RAG Scopes ---
TENANT_ID=default
ENGAGEMENT_ID=default

# --- Vector Search ---
# Create Index & Endpoint in Vertex AI Vector Search
VECTOR_INDEX_NAME=omnihub-vector-index
VECTOR_INDEX_ENDPOINT=projects/.../locations/.../indexEndpoints/...
VECTOR_DEPLOYED_INDEX_ID=my_deployed_index_id

# --- RAG Logic ---
# Defaults
VERTEX_MODEL_NAME=gemini-1.5-flash-001
VERTEX_EMBED_MODEL=text-embedding-004
DEFAULT_TOP_K=8
CHUNK_SIZE_HINT=1000
CHUNK_OVERLAP_HINT=200
